# Example environment variables for GestionAbsence_App
# Copy this file to .env and fill in real values for local development.

# SMTP / Email
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=absences@example.com
SENDER_PASSWORD=your_app_password

# Database backend: sqlite or mysql
DB_BACKEND=sqlite
# If sqlite: DB_PATH can be a path to an sqlite file (default: absences.db)
DB_PATH=absences.db

# If using MySQL, provide connection string or components
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=gestion_absence

# App preferences
APP_ENV=development

